    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst agora = new Date();\nconst ultimoHeartbeat = new Date(data.lastHeartbeat);\n\nconst segundosSemHeartbeat = Math.floor(\n  (agora.getTime() - ultimoHeartbeat.getTime()) / 1000\n);\n\nconst minutos = Math.floor(segundosSemHeartbeat / 60);\nconst segundos = segundosSemHeartbeat % 60;\n\nlet tempoSemHeartbeat;\n\nif (minutos > 0) {\n  tempoSemHeartbeat = `${minutos}min ${segundos}s`;\n} else {\n  tempoSemHeartbeat = `${segundos}s`;\n}\n\nconst horario = agora.toLocaleString('pt-BR', {\n  timeZone: 'America/Fortaleza'\n});\n\nconst ultimo = ultimoHeartbeat.toLocaleString('pt-BR', {\n  timeZone: 'America/Fortaleza'\n});\n\nconst mensagem =\n`🚨 *ALERTA DE INTERNET*\n\n🔴 *LINK OFFLINE*\n\n🔌 *Interface:* \\`pppoe-opennet\\`\n🖥️ *Router:* \\`hEX\\`\n\n❌ O MikroTik parou de enviar o heartbeat.\n\n🕐 *Último heartbeat:* ${ultimo}\n🕐 *Verificação:* ${horario}\n\n⏱️ *Sem comunicação:* ${tempoSemHeartbeat}\n\n⚠️ Verifique o link PPPoE.`;\n\nreturn [\n  {\n    json: {\n      ...data,\n      mensagem\n    }\n  }\n];"
      },
